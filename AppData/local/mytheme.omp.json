{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "black": "#262B44",
    "blue": "#4B95E9",
    "green": "#59C9A5",
    "orange": "#F07623",
    "red": "#F38BA8",
    "white": "#E0DEF4",
    "yellow": "#F9E2AF",
		"purple": "#FF00FF",
		"pink": "#F5C2E7",
		"lavender": "#B4BEFE"
  },
  "secondary_prompt": {
    "template": "<p:yellow,transparent>\ue0b6</><,p:yellow> > </><p:yellow,transparent>\ue0b0</> ",
    "foreground": "p:black",
    "background": "transparent"
  },
  "upgrade": {
    "source": "cdn",
    "interval": "240h",
    "auto": true,
    "notice": false
  },
  "console_title_template": "{{ .Shell }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": " {{ .Path }} ",
          "foreground": "p:blue",
          "type": "path",
          "style": "plain",
					"options": {
						"style": "folder"
					}
        },
        {
          "options": {
            "branch_template": "{{ trunc 25 .Branch }}",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
					"template": " {{ if .UpstreamURL }}{{ url .UpstreamIcon .UpstreamURL }} {{ end }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}{{ .Working.String }}{{ end }}{{ if .Staging.Changed }} | {{ .Staging.String }}{{ end }} ",
          "foreground": "p:green",
          "type": "git",
          "style": "plain",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:pink{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:lavender{{ end }}",
            "{{ if gt .Ahead 0 }}p:white{{ end }}"
          ]
        },
        {
          "template": " \uf0e7 ",
          "foreground": "p:white",
          "background": "p:yellow",
          "type": "root",
          "style": "powerline"
        },
        {
          "options": {
            "always_enabled": true
          },
          "template": ">",
          "foreground": "p:white",
          "type": "status",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "options": {
            "display_mode": "files",
            "fetch_package_manager": false,
            "home_enabled": false
          },
          "template": "\ue718 ",
          "foreground": "p:green",
          "background": "transparent",
          "type": "node",
          "style": "plain"
        },
        {
          "options": {
            "fetch_version": false
          },
          "template": "\ue626 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "p:blue",
          "background": "transparent",
          "type": "go",
          "style": "plain"
        },
        {
          "options": {
            "display_mode": "files",
            "fetch_version": false,
            "fetch_virtual_env": false
          },
          "template": "\ue235 ",
          "foreground": "p:yellow",
          "background": "transparent",
          "type": "python",
          "style": "plain"
        },
				{
					"type": "lua",
					"style": "plain",
					"foreground": "white",
					"template": "  {{ .Full }} "
				}
      ]
    }
  ]
}
